#!/bin/sh
set -e

echo "Setting up backup directory permissions..."

if [ -d /backups ]; then
    CURRENT_PERMS=$(stat -c '%a' /backups 2>/dev/null || echo "0")
    if [ "$CURRENT_PERMS" != "777" ]; then
        echo "Setting permissions for /backups..."
        chmod 777 /backups
        echo "✓ Backup directory permissions set to 777"
    else
        echo "✓ Backup directory permissions already correct (777)"
    fi
else
    echo "ℹ Backup directory (/backups) not mounted, skipping"
fi

echo "Starting database manager..."
exec interactive_manager "$@"